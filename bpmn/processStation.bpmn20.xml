      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_s_pour_signature'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_visa_verif" name="Pour Vérification" sourceRef="Gw_s_visa" targetRef="Task_s_etude">
      <extensionElements>
        <flowable:properties>
