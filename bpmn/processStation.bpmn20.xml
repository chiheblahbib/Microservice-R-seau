      </extensionElements>
    </userTask>
    <userTask id="Task_s_orientation" name="Orientation du Dossier" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:dueDate="P2D" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'OrientationStationNotif')}" event="start" />
        <flowable:inputOutput>
