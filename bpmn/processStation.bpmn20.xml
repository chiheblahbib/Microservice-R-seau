      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','En attente')}" event="start" />
        <flowable:executionListener expression="${createEvent._execute(execution,'DepotStationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">WRITE</flowable:entry>
              <flowable:entry key="SectionSite">WRITE</flowable:entry>
              <flowable:entry key="SectionFrequence">WRITE</flowable:entry>
              <flowable:entry key="SectionAttachment">WRITE</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="Task_s_numerotation" name="Contrôle &#38; Numérotation" flowable:assignee="Service Numérotation" flowable:candidateGroups="Numerotation" flowable:formFieldValidation="true">
