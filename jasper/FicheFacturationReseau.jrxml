	</parameter>
	<parameter name="DATE_EMISSION" class="java.util.Date" isForPrompting="false">
		<parameterDescription><![CDATA[Date d'émission imprimée sur la fiche ; par défaut, la date de génération.]]></parameterDescription>
	</parameter>
	<parameter name="LIBELLES" class="java.util.Map" isForPrompting="false">
		<parameterDescription><![CDATA[Libellés des énumérations du service reseau (repris de reseau-vocabulaire.ts côté front).]]></parameterDescription>
		<defaultValueExpression><![CDATA[java.util.stream.Stream.of(new String[][] {
	{"PRIVE", "Réseau privé"},
	{"OUVERT_AU_PUBLIC", "Réseau ouvert au public"},
	{"NOUVEAU", "Nouveau réseau"},
	{"MODIFICATION", "Modification du réseau"},
	{"RENOUVELLEMENT", "Renouvellement d’autorisation"},
	{"FH", "Réseau FH"},
	{"VSAT", "VSAT"},
	{"STATION_TERRIENNE", "Station terrienne"},
	{"FIBRE_OPTIQUE", "Réseau fibre optique"},
	{"IOT", "Internet des objets (IoT)"},
	{"BLR", "Réseau BLR (boucle locale radio)"},
	{"PMR", "Réseau PMR (radiocommunication d’entreprise)"},
	{"AUTRE", "Autre"}
}).collect(java.util.stream.Collectors.toMap(e -> e[0], e -> e[1]))]]></defaultValueExpression>
	</parameter>
