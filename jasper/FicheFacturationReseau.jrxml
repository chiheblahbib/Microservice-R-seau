    .atZone(java.time.ZoneId.of($P{FUSEAU_HORAIRE})).format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy", java.util.Locale.FRENCH))]]></variableExpression>
	</variable>
	<variable name="typesLibelle" class="java.lang.String">
		<variableExpression><![CDATA[((java.util.function.Function<String, String>) t -> {
  if (t == null || t.trim().isEmpty()) { return ""; }
  try {
    com.fasterxml.jackson.databind.JsonNode n = new com.fasterxml.jackson.databind.ObjectMapper().readTree(t);
    java.util.List<String> l = new java.util.ArrayList<>();
    if (n != null && n.isArray()) {
      for (com.fasterxml.jackson.databind.JsonNode e : n) {
        if (e == null || e.get("type") == null || e.get("type").isNull()) { continue; }
        String type = e.get("type").asText();
        l.add("AUTRE".equals(type) && e.get("precisionAutre") != null && !e.get("precisionAutre").isNull()
            ? e.get("precisionAutre").asText()
            : String.valueOf($P{LIBELLES}.getOrDefault(type, type)));
      }
    }
    return String.join(", ", l);
  } catch (Exception ex) { return ""; }
}).apply($F{typesReseau})]]></variableExpression>
	</variable>
	<variable name="nombreSites" class="java.lang.Integer">
		<variableExpression><![CDATA[((java.util.function.Function<String, Integer>) t -> {
  if (t == null || t.trim().isEmpty()) { return 0; }
  try {
    com.fasterxml.jackson.databind.JsonNode n = new com.fasterxml.jackson.databind.ObjectMapper().readTree(t);
    return n != null && n.isArray() ? n.size() : 0;
  } catch (Exception ex) { return 0; }
}).apply($F{sites})]]></variableExpression>
	</variable>
	<variable name="lignesJson" class="java.lang.String">
		<variableExpression><![CDATA[((java.util.function.Supplier<String>) () -> {
  try {
    com.fasterxml.jackson.databind.ObjectMapper om = new com.fasterxml.jackson.databind.ObjectMapper();
    if ($F{lignesFacturation} != null && !$F{lignesFacturation}.trim().isEmpty()) {
      com.fasterxml.jackson.databind.JsonNode n = om.readTree($F{lignesFacturation});
      if (n != null && n.isArray() && n.size() > 0) { return n.toString(); }
    }
    if ($F{fraisDossier} == null) { return "[]"; }
    com.fasterxml.jackson.databind.node.ObjectNode l = om.createObjectNode();
    String nature = $F{natureReseau} == null ? null : String.valueOf($P{LIBELLES}.getOrDefault($F{natureReseau}, $F{natureReseau}));
    l.put("designation", "Frais de dossier" + (nature != null ? " — " + nature.toLowerCase(java.util.Locale.FRENCH) : ""));
    if ($F{codeNatureFraisDossier} != null) { l.put("codeNature", $F{codeNatureFraisDossier}); }
    l.put("quantite", java.math.BigDecimal.ONE);
    l.put("prixUnitaire", $F{fraisDossier});
    l.put("montant", $F{fraisDossier});
    return om.createArrayNode().add(l).toString();
  } catch (Exception ex) { return "[]"; }
}).get()]]></variableExpression>
	</variable>
	<variable name="nombreLignes" class="java.lang.Integer">
		<variableExpression><![CDATA[((java.util.function.Function<String, Integer>) t -> {
  try { return new com.fasterxml.jackson.databind.ObjectMapper().readTree(t).size(); } catch (Exception ex) { return 0; }
}).apply($V{lignesJson})]]></variableExpression>
	</variable>
	<variable name="total" class="java.math.BigDecimal">
		<variableExpression><![CDATA[((java.util.function.Function<String, java.math.BigDecimal>) t -> {
  java.util.function.Function<com.fasterxml.jackson.databind.JsonNode, java.math.BigDecimal> nombre = v -> {
    if (v == null || v.isNull()) { return null; }
    if (v.isNumber()) { return v.decimalValue(); }
    String s = v.asText().replaceAll("[\\s  ]", "").replace(',', '.');
    try { return s.isEmpty() ? null : new java.math.BigDecimal(s); } catch (NumberFormatException e) { return null; }
  };
  try {
    java.math.BigDecimal somme = java.math.BigDecimal.ZERO;
    for (com.fasterxml.jackson.databind.JsonNode l : new com.fasterxml.jackson.databind.ObjectMapper().readTree(t)) {
      java.math.BigDecimal m = nombre.apply(l.get("montant"));
      if (m == null) {
        java.math.BigDecimal p = nombre.apply(l.get("prixUnitaire"));
        java.math.BigDecimal q = nombre.apply(l.get("quantite"));
        m = p == null ? null : p.multiply(q == null ? java.math.BigDecimal.ONE : q);
      }
      if (m != null) { somme = somme.add(m); }
    }
    return somme;
  } catch (Exception ex) { return null; }
}).apply($V{lignesJson})]]></variableExpression>
	</variable>
	<variable name="totalTexte" class="java.lang.String">
		<variableExpression><![CDATA[$V{total} == null || $V{nombreLignes} == 0 ? "—"
: String.format(java.util.Locale.FRANCE, "%,.0f", $V{total}).replace(' ', ' ') + " " + $V{devise}]]></variableExpression>
	</variable>
	<variable name="agent" class="java.lang.String">
		<variableExpression><![CDATA[$F{agentComptable} != null && !$F{agentComptable}.trim().isEmpty() ? $F{agentComptable}.trim()
: $F{approvedBy} != null && !$F{approvedBy}.trim().isEmpty() ? $F{approvedBy}.trim() : null]]></variableExpression>
	</variable>
	<variable name="signatureAgent" class="java.lang.String">
		<variableExpression><![CDATA[$F{signatureAgentComptable} != null && !$F{signatureAgentComptable}.trim().isEmpty() ? $F{signatureAgentComptable}
: $F{signatureAgentTechnique} != null && !$F{signatureAgentTechnique}.trim().isEmpty() ? $F{signatureAgentTechnique} : null]]></variableExpression>
	</variable>
