		<band height="172" splitType="Prevent">
			<textField textAdjust="StretchHeight">
				<reportElement style="Section" positionType="Float" x="12" y="8" width="531" height="15" uuid="f18c5fa4-7682-5446-a05a-31b6cf868229"/>
				<textFieldExpression><![CDATA["5. CONFIRMATION DE RÉCEPTION"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="12" y="27" width="531" height="22" uuid="5c12f525-4bc2-5669-9228-cf31fc8787db"/>
				<box leftPadding="10" rightPadding="10"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="none">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Nous accusons bonne réception de votre demande enregistrée sous la référence ci-dessus. Votre dossier est désormais transmis aux services compétents pour instruction."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" mode="Opaque" backcolor="#DEEBF7" x="12" y="52" width="531" height="26" uuid="2d8118ff-bb32-58a5-8542-159b3ced7795"/>
				<box topPadding="4" leftPadding="10" bottomPadding="4" rightPadding="10"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Important :</b> conservez ce document. La référence du dossier vous sera demandée pour tout suivi. Vous pouvez consulter l’état d’avancement de votre demande en ligne sur <b>www.arcep.ga</b> ou par téléphone au <b>+241 11 44 68 11/12</b>."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="12" y="82" width="531" height="14" uuid="0dfe52a1-84f7-5443-8143-bd2cef063ce9"/>
				<box leftPadding="10"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Agent récepteur : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{assignee} != null ? $F{assignee} : "—") + "</b>"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="190" y="100" width="175" height="14" uuid="aaf971f5-69d7-525d-b853-d0fbd73f6fbd"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Signature Électronique Unique"]]></textFieldExpression>
			</textField>
			<componentElement>
				<reportElement positionType="Float" x="251" y="116" width="52" height="52" uuid="ee39428a-0fa8-55e2-81f2-39e868e5e976"/>
				<jr:QRCode xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" margin="0" errorCorrectionLevel="H">
					<jr:codeExpression><![CDATA[((java.util.function.Function<String, String>) q -> q.length() > 300 ? q.substring(0, 300) : q).apply(
    "ARCEP - ACCUSE DE RECEPTION - DOSSIER RESEAU N " + ($F{reference} != null ? $F{reference} : "") + ($V{dateReception} != null ? " - RECU LE " + $V{dateReception}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm")) : ""))]]></jr:codeExpression>
				</jr:QRCode>
