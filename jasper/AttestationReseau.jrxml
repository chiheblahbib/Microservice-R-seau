	<variable name="titulaire" class="java.lang.String">
		<variableExpression><![CDATA[$F{company} != null && !$F{company}.trim().isEmpty() ? $F{company} : $F{clientName}]]></variableExpression>
	</variable>
	<variable name="typesLibelle" class="java.lang.String">
		<variableExpression><![CDATA[$F{typesReseau} == null || $F{typesReseau}.trim().isEmpty() ? ""
: ((java.util.List<java.util.Map<String, Object>>) new com.fasterxml.jackson.databind.ObjectMapper()
    .readValue($F{typesReseau}, java.util.List.class))
  .stream()
  .filter(e -> e != null && e.get("type") != null)
  .map(e -> "AUTRE".equals(e.get("type")) && e.get("precisionAutre") != null
        ? String.valueOf(e.get("precisionAutre"))
        : (String) $P{LIBELLES}.getOrDefault(String.valueOf(e.get("type")), String.valueOf(e.get("type"))))
  .collect(java.util.stream.Collectors.joining(", "))]]></variableExpression>
	</variable>
	<variable name="servicesLibelle" class="java.lang.String">
		<variableExpression><![CDATA[$F{services} == null || $F{services}.trim().isEmpty() ? ""
: ((java.util.List<java.util.Map<String, Object>>) new com.fasterxml.jackson.databind.ObjectMapper()
    .readValue($F{services}, java.util.List.class))
  .stream()
  .filter(e -> e != null && e.get("type") != null)
  .map(e -> $P{LIBELLES}.getOrDefault(String.valueOf(e.get("type")), String.valueOf(e.get("type")))
        + (e.get("portee") != null ? " (portée " + $P{LIBELLES}.getOrDefault(String.valueOf(e.get("portee")), String.valueOf(e.get("portee"))) + ")" : ""))
  .collect(java.util.stream.Collectors.joining(", "))]]></variableExpression>
	</variable>
	<variable name="nombreSites" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{sites} == null || $F{sites}.trim().isEmpty() ? 0
: new com.fasterxml.jackson.databind.ObjectMapper().readTree($F{sites}).size()]]></variableExpression>
	</variable>
	<variable name="nombreLiaisons" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{liaisons} == null || $F{liaisons}.trim().isEmpty() ? 0
: new com.fasterxml.jackson.databind.ObjectMapper().readTree($F{liaisons}).size()]]></variableExpression>
	</variable>
	<variable name="nomsSites" class="java.util.Map">
		<variableExpression><![CDATA[$F{sites} == null || $F{sites}.trim().isEmpty() ? new java.util.HashMap<String, String>()
: ((java.util.List<java.util.Map<String, Object>>) new com.fasterxml.jackson.databind.ObjectMapper()
    .readValue($F{sites}, java.util.List.class))
  .stream()
  .filter(s -> s != null && s.get("id") != null)
  .collect(java.util.stream.Collectors.toMap(
      s -> String.valueOf(s.get("id")).replaceFirst("[.]0+$", ""),
      s -> s.get("nomSite") != null ? String.valueOf(s.get("nomSite")) : "Site n° " + String.valueOf(s.get("id")).replaceFirst("[.]0+$", ""),
      (a, b) -> a))]]></variableExpression>
	</variable>
	<variable name="numeroAutorisation" class="java.lang.String">
		<variableExpression><![CDATA[$F{referenceAttestation} == null ? "……………"
: $F{referenceAttestation}.matches("\\d+-\\d{2}-\\d{2}-\\d{4}")
  ? $F{referenceAttestation}.replaceAll("^(\\d+)-\\d{2}-\\d{2}-(\\d{4})$", "$1/AUT/RP/ARCEP/$2")
  : $F{referenceAttestation}]]></variableExpression>
	</variable>
	<variable name="dateSignature" class="java.lang.String">
		<variableExpression><![CDATA[($P{DATE_SIGNATURE} != null ? $P{DATE_SIGNATURE}.toInstant()
 : $F{dateAttestation} != null && $F{dateAttestation}.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}.*") ? java.time.ZonedDateTime.parse($F{dateAttestation}, java.time.format.DateTimeFormatter.ISO_DATE_TIME.withZone(java.time.ZoneId.of($P{FUSEAU_HORAIRE}))).withZoneSameInstant(java.time.ZoneId.of($P{FUSEAU_HORAIRE})).toInstant()
 : java.time.Instant.now())
    .atZone(java.time.ZoneId.of($P{FUSEAU_HORAIRE})).format(java.time.format.DateTimeFormatter.ofPattern("dd MMMM yyyy", java.util.Locale.FRENCH))]]></variableExpression>
	</variable>
