					<font size="9.5" isBold="true"/>
				</textElement>
				<text><![CDATA[AUTORITE DE REGULATION DES
COMMUNICATIONS ELECTRONIQUES
ET DES POSTES]]></text>
			</staticText>
			<staticText>
				<reportElement x="118" y="55" width="250" height="12" uuid="3b767251-7153-5340-8172-e1f8e0e44967"/>
				<textElement textAlignment="Center">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[PRESIDENCE DU CONSEIL DE REGULATION]]></text>
			</staticText>
			<staticText>
				<reportElement x="372" y="12" width="153" height="14" uuid="c6ba9ae7-1438-53ec-a77b-b77e6be6fd2e"/>
				<textElement textAlignment="Center">
					<font size="9.5" isBold="true"/>
				</textElement>
				<text><![CDATA[REPUBLIQUE GABONAISE]]></text>
			</staticText>
			<staticText>
				<reportElement x="372" y="26" width="153" height="12" uuid="a4183f9c-6e9d-5820-b715-636b9f12d526"/>
				<textElement textAlignment="Center">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Union-Travail-Justice]]></text>
			</staticText>
			<!-- evaluationTime="Report" : au titre, les variables ne sont pas encore calculées -->
			<textField evaluationTime="Report">
				<reportElement x="44" y="78" width="451" height="42" uuid="aededb9a-99d7-5d3b-964c-227fdaec783c"/>
				<box>
					<pen lineWidth="1.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["AUTORISATION N° " + $V{numeroAutorisation} + " RELATIVE\nA L'ETABLISSEMENT ET A L'EXPLOITATION DE RESEAUX PRIVES"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="16" y="134" width="507" height="80" uuid="ab94c054-ab2e-5571-82cf-c0e0ff1801ac"/>
				<textElement markup="styled">
					<font size="10"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.15" spacingAfter="2"/>
				</textElement>
				<textFieldExpression><![CDATA["Titulaire : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{company} != null && !$F{company}.trim().isEmpty() ? $F{company} : ($F{clientName} != null ? $F{clientName} : "—")) + "</b>"
+ ($F{tradeRegisterNumber} != null ? "        RCCM : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{tradeRegisterNumber}) + "</b>" : "")
+ "\nReprésenté par : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{applicantName} != null ? $F{applicantName} : "—") + "</b>"
+ ($F{qualification} != null ? " en qualité de <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{qualification}) + "</b>" : "")
+ "\nNationalité : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{nationalityComplet} != null ? $F{nationalityComplet} : ($F{nationality} != null ? $F{nationality} : "—")) + "</b>"
+ "        Adresse : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{clientAddress} != null ? $F{clientAddress} : "—") + "</b>"
+ "\nN° Tél : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{clientPhone} != null ? $F{clientPhone} : ($F{applicantPhone} != null ? $F{applicantPhone} : "—")) + "</b>"
+ "\nE-mail : <b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{applicantEmail} != null ? $F{applicantEmail} : ($F{clientEmail} != null ? $F{clientEmail} : "—")) + "</b>"]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band height="8" splitType="Stretch"/>
	</pageHeader>
	<detail>
		<band height="26" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{natureReseau} != null && !"PRIVE".equals($F{natureReseau})]]></printWhenExpression>
			<staticText>
				<reportElement mode="Opaque" x="16" y="2" width="507" height="20" forecolor="#B42318" backcolor="#FDECEA" uuid="4260b1b4-ca58-5e39-a4ff-4443fe71e00b"/>
				<box leftPadding="6" rightPadding="6">
					<pen lineWidth="1.0" lineColor="#B42318"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8.5" isBold="true"/>
				</textElement>
				<text><![CDATA[Modèle réservé aux réseaux privés : ce dossier porte sur un réseau ouvert au public.]]></text>
			</staticText>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="fc68e9d7-8707-58fd-aaef-ce0ff76edd80"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre premier :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="ea7389f3-56a4-5422-a96c-5d9414d5310d"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Du cadre et de l'objet de l'Autorisation]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="604c794a-69d1-5a5f-bd0d-d01010394b8a"/>
				<textFieldExpression><![CDATA["<b>Article premier</b> : La présente Autorisation, prise en application des dispositions combinées des articles 10 de la loi n°005/2001 du 27 juin 2001 portant réglementation du secteur des Télécommunications en République gabonaise, 18 de la loi n°026/2018 du 22 octobre 2019 portant réglementation des communications électroniques en République gabonaise et 11 de l'ordonnance n°0000008/PR/2012 du 13 février 2012 portant création et organisation de l'Autorité de Régulation des Communications Electroniques et des Postes en abrégée <b>ARCEP</b>, confère au Titulaire le droit d'établir et d'exploiter un réseau privé."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="6b19574e-06f0-5bd1-bde6-ac2cd7188d4f"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 2 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="46945f29-ba50-59b7-99f5-1287dd268644"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[De la nature du réseau et des services exploités]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="df51076c-90c6-59dc-bdc3-302edb250e90"/>
				<textFieldExpression><![CDATA["<b>Article 2</b> : La présente Autorisation porte sur l'établissement et l'exploitation d'un réseau privé"
+ ($V{nombreSites} > 0 ? " comprenant " + $V{sitesEnLettres} + ($V{nombreSites} > 1 ? " sites" : " site") : "")
+ ($V{typesLibelle}.isEmpty() ? "" : ($V{nombreSites} > 0 ? "," : "") + " de type" + ($V{nombreTypes} > 1 ? "s " : " ")
    + "<b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{typesLibelle}) + "</b>")
+ "."
+ "\nLes caractéristiques de ce réseau, objet de la présente Autorisation, sont décrites en annexe."
+ "\n<b>Article 3</b> : Le Titulaire est autorisé à exploiter "
+ ($V{nombreServices} == 0 ? "les services déclarés dans sa demande"
    : ($V{nombreServices} > 1 ? "les services de " : "le service de ")
      + "<b>" + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{servicesLibelle}) + "</b>")
+ "."
+ "\nToutefois, si le Titulaire souhaite fournir un nouveau service, il est tenu de requérir l'avis préalable de l'ARCEP."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="15fa7225-43d1-56ae-95fa-fe021e9c9d0b"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 3 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="2c8ff087-98ba-589b-9c1e-2bf7e9586053"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Des conditions d'exploitation]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="f579995e-aeb5-57fa-8b3b-fd3353fb003f"/>
				<textFieldExpression><![CDATA["<b>Article 4</b> : Le Titulaire établit et exploite le réseau privé susmentionné dans le respect de la législation en vigueur en République gabonaise."
+ "\n<b>Article 5</b> : Le réseau du Titulaire est conforme à l'architecture décrite en annexe."
+ "\nToutefois, si le Titulaire souhaite modifier les caractéristiques de son réseau, il est tenu de requérir l'avis préalable de l'ARCEP, qui le cas échéant, met à jour l'annexe susvisée."
+ "\n<b>Article 6</b> : Conformément à la réglementation en vigueur en République gabonaise, le Titulaire est autorisé à exploiter les ressources en fréquences radioélectriques qui lui sont assignées."
+ "\n<b>Article 7</b> : Le réseau privé établi et exploité par le Titulaire est conforme aux normes en vigueur, notamment celles de l'Union Internationale des Télécommunications."
+ "\n<b>Article 8</b> : Le Titulaire veille à ce que les équipements terminaux qu'il utilise et exploite sur son réseau soient préalablement homologués par l'ARCEP conformément à la législation en vigueur en République gabonaise."
+ "\n<b>Article 9</b> : Le Titulaire n'est pas autorisé à établir des liaisons filaires dans le domaine public."
+ "\nToutefois, il peut recourir aux offres de location des capacités des opérateurs dûment autorisés."
+ "\nEn cas d'absence d'offres, le Titulaire requiert des Autorités administratives compétentes, des autorisations y relatives, conformément à la réglementation en vigueur en République gabonaise."
+ "\nIl est entendu que l'autorisation de l'ARCEP est donnée en dernier ressort."
+ "\n<b>Article 10</b> : L'établissement et l'exploitation du réseau privé objet de la présente Autorisation ne doit pas causer de brouillage préjudiciable aux autres réseaux."
+ "\nEn cas de brouillage préjudiciable de ses équipements, le Titulaire est tenu d'informer l'ARCEP et de mettre en œuvre, dans les meilleurs délais, les moyens techniques et humains susceptibles de pallier les conséquences les plus graves des défaillances de ses équipements."
+ "\n<b>Article 11</b> : Le Titulaire se conforme au respect des exigences et prescriptions en matière de Sécurité publique et de Défense nationale."
+ "\n<b>Article 12</b> : La présente Autorisation est strictement personnelle. Elle ne peut être vendue, louée, cédée ou donnée en garantie."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="e711fdc2-f575-5f62-b87b-dfb991f35692"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 4 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="900bcc92-a615-51a8-b7c7-3624564bbe35"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Du contrôle]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="91f55bea-360f-5d88-a334-fd28c874e7e7"/>
				<textFieldExpression><![CDATA["<b>Article 13</b> : L'ARCEP procède à des contrôles inopinés ou programmés relatifs au bon fonctionnement des équipements terminaux du réseau privé par le Titulaire. Tout projet de contrôle programmé est préalablement notifié au Titulaire dans un délai de quarante-huit (48) heures."
+ "\nLe Titulaire met à la disposition du personnel mandaté par l'ARCEP des informations et documents nécessaires aux opérations de contrôle."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="c082fcda-eaef-5fe5-a7c5-9adab61788b5"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 5 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="c649e639-c444-5670-8df5-048cdfb7a0ba"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Des redevances]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="3e92556d-fd96-5fc4-acbb-476ebcf5875d"/>
				<textFieldExpression><![CDATA["<b>Article 14</b> : Le Titulaire s'engage à s'acquitter dans les délais fixés, des frais, redevances, contributions et taxes relatifs à l'établissement et à l'exploitation du réseau privé, objet de la présente Autorisation, conformément à la législation en vigueur en République gabonaise."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="dd31b810-ebf8-51e2-82fe-6bdb6fe4e836"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 6 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="a7c39d90-d6fd-57b5-84da-8bd30a7de748"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[De la durée, du renouvellement et de la modification]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="396d17ff-72ab-53bd-a64d-bb6027c4c0c0"/>
				<textFieldExpression><![CDATA["<b>Article 15</b> : La présente Autorisation est valable pour une durée de cinq (05) ans, renouvelable."
+ "\nLa présente Autorisation est renouvelée sur demande du Titulaire, adressée à l'ARCEP six (06) mois au plus tard avant son expiration."
+ "\nCe renouvellement peut faire l'objet des modifications de tout ou partie des obligations contenues dans la présente Autorisation."
+ "\n<b>Article 16</b> : Elle peut être modifiée à l'initiative de l'Autorité de Régulation et ou sur demande écrite du Titulaire et après accord préalable de l'ARCEP."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="0e786f66-1082-5bc1-bcae-f8fbbebc2c91"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 7 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="b90c5c1c-d146-5432-9f11-a0f05a6fbf49"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Des sanctions]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="6bf1ffb4-e303-58d1-9122-f7bf5bc71823"/>
				<textFieldExpression><![CDATA["<b>Article 17</b> : En cas de non-respect des dispositions de la présente Autorisation, ou s'il apparaît, à la suite de l'établissement et de l'exploitation du réseau privé objet de la présente Autorisation, que le Titulaire porte atteinte à la sûreté ou à l'ordre public ou est contraire à la morale et aux bonnes mœurs, l'ARCEP peut, sans préjudice d'éventuelles poursuites pénales, prononcer des sanctions dans les conditions prévues par la législation en vigueur."]]></textFieldExpression>
			</textField>
		</band>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement x="16" y="8" width="112" height="14" uuid="e54f2ce3-edcb-50dd-a299-be3c841aa8be"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Chapitre 8 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="128" y="8" width="395" height="14" uuid="ab58768f-9fef-5734-b5ed-bad2f703df1d"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Des dispositions finales]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="Article" x="16" y="26" width="507" height="20" uuid="2485b963-0cb0-54ba-8b2c-29676ea8aba6"/>
				<textFieldExpression><![CDATA["<b>Article 18</b> : La présente Autorisation, qui prend effet pour compter de sa date de signature, est enregistrée, et notifiée à l'intéressé, conformément aux dispositions de l'article 15 nouveau de l'ordonnance n°0000008/PR/2012 du 13 février 2012 susvisée."]]></textFieldExpression>
			</textField>
		</band>
		<band height="150" splitType="Prevent">
			<textField>
				<reportElement x="263" y="10" width="260" height="16" uuid="268fa377-f93f-5b7a-8a68-a15b958a9386"/>
				<textElement textAlignment="Right">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Fait à Libreville, le " + $V{dateSignature}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="263" y="32" width="260" height="16" uuid="a11412b8-d362-57ed-bc37-cc585cf7b5b5"/>
				<textElement textAlignment="Center">
					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{SIGNATAIRE_QUALITE}]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
				<reportElement x="313" y="52" width="160" height="64" uuid="fd608837-14e9-501e-a67c-f388c42a3812">
					<printWhenExpression><![CDATA[$F{signaturePresidence} != null && !$F{signaturePresidence}.isEmpty()]]></printWhenExpression>
				</reportElement>
				<imageExpression><![CDATA[java.util.Base64.getMimeDecoder().decode($F{signaturePresidence}.replaceFirst("^data:[^,]*,", ""))]]></imageExpression>
			</image>
			<textField isBlankWhenNull="true">
				<reportElement x="263" y="120" width="260" height="16" uuid="410a1b31-4015-58ac-b2c6-4b6ae99d1086"/>
				<textElement textAlignment="Center">
					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{SIGNATAIRE_NOM}]]></textFieldExpression>
			</textField>
		</band>
		<band height="22" splitType="Prevent">
			<textField>
				<reportElement x="16" y="6" width="507" height="12" forecolor="#6B7280" uuid="5829f5ef-8c75-53a8-b451-76b1c4c62091"/>
				<textElement>
					<font size="7"/>
				</textElement>
				<textFieldExpression><![CDATA["Dossier n° " + ($F{reference} != null ? $F{reference} : "—")
+ " — Attestation n° " + ($F{referenceAttestation} != null ? $F{referenceAttestation} : "—")
+ " — Valable cinq (05) ans à compter de sa signature (article 15)."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
