				<imageExpression><![CDATA[$P{logo-arcep}]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="118" y="12" width="250" height="40" uuid="eea253f6-27f3-5517-8fb3-f06edd4b2dfb"/>
