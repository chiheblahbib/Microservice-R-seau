		<field name="longitudeMinutes" class="java.lang.Integer"/>
		<field name="longitudeSecondes" class="java.lang.Double"/>
		<field name="altitude" class="java.lang.Double"/>
	</subDataset>
	<subDataset name="dsLiaisons" uuid="809cc629-3a8a-5224-b8e0-92686f654778">
		<parameter name="SITES" class="java.lang.Object"/>
		<field name="nature" class="java.lang.String"/>
		<field name="precisionAutre" class="java.lang.String"/>
		<field name="bandeFrequences" class="java.lang.String"/>
		<field name="debitEmission" class="java.lang.Double"/>
		<field name="debitReception" class="java.lang.Double"/>
		<field name="nombreBonds" class="java.lang.Integer"/>
		<field name="siteOrigineId" class="java.lang.Long"/>
		<field name="siteExtremiteId" class="java.lang.Long"/>
	</subDataset>
	<parameter name="logo-arcep" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.Base64.getDecoder().decode("")]]></defaultValueExpression>
	</parameter>
	<parameter name="filigrane-arcep" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.Base64.getDecoder().decode("")]]></defaultValueExpression>
	</parameter>
	<parameter name="FUSEAU_HORAIRE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Africa/Libreville"]]></defaultValueExpression>
	</parameter>
	<parameter name="DATE_SIGNATURE" class="java.util.Date" isForPrompting="false">
		<parameterDescription><![CDATA[Date imprimée après « Fait à Libreville, le ». Vide : date de génération.]]></parameterDescription>
	</parameter>
	<parameter name="SIGNATAIRE_QUALITE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Le Président du Conseil de Régulation"]]></defaultValueExpression>
	</parameter>
	<parameter name="SIGNATAIRE_NOM" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Prénom et NOM imprimés sous la signature. Vide : ligne laissée blanche.]]></parameterDescription>
	</parameter>
	<parameter name="LIBELLES" class="java.util.Map" isForPrompting="false">
		<parameterDescription><![CDATA[Libellés des énumérations du service reseau (repris de reseau-vocabulaire.ts côté front).]]></parameterDescription>
		<defaultValueExpression><![CDATA[java.util.stream.Stream.of(new String[][] {
	{"FH", "Réseau FH"},
	{"VSAT", "VSAT"},
	{"STATION_TERRIENNE", "Station terrienne"},
	{"FIBRE_OPTIQUE", "Réseau fibre optique"},
	{"IOT", "Internet des objets (IoT)"},
	{"BLR", "Réseau BLR (boucle locale radio)"},
	{"PMR", "Réseau PMR (radiocommunication d’entreprise)"},
	{"AUTRE", "Autre"},
	{"ACCES_INTERNET", "Accès à Internet"},
	{"TRANSMISSION_DONNEES", "Transmission de données"},
	{"TELEPHONIE", "Téléphonie"},
	{"TELEPHONIE_IP", "Téléphonie sur IP"},
	{"LOCALE", "au niveau local"},
	{"NATIONALE", "au niveau national"},
	{"INTERNATIONALE", "à l'international"}
}).collect(java.util.stream.Collectors.toMap(e -> e[0], e -> e[1]))]]></defaultValueExpression>
	</parameter>
	<queryString language="json">
		<![CDATA[]]>
	</queryString>
	<field name="reference" class="java.lang.String"/>
	<field name="natureReseau" class="java.lang.String"/>
	<field name="referenceAttestation" class="java.lang.String">
		<fieldDescription><![CDATA[attestations[0].reference]]></fieldDescription>
	</field>
	<field name="company" class="java.lang.String">
		<fieldDescription><![CDATA[client.company]]></fieldDescription>
	</field>
	<field name="clientName" class="java.lang.String">
		<fieldDescription><![CDATA[client.clientName]]></fieldDescription>
	</field>
	<field name="tradeRegisterNumber" class="java.lang.String">
		<fieldDescription><![CDATA[client.tradeRegisterNumber]]></fieldDescription>
	</field>
	<field name="clientAddress" class="java.lang.String">
		<fieldDescription><![CDATA[client.address]]></fieldDescription>
	</field>
	<field name="clientPhone" class="java.lang.String">
		<fieldDescription><![CDATA[client.phone]]></fieldDescription>
	</field>
	<field name="clientEmail" class="java.lang.String">
		<fieldDescription><![CDATA[client.email]]></fieldDescription>
	</field>
	<field name="applicantName" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.applicantName]]></fieldDescription>
	</field>
	<field name="qualification" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.qualification]]></fieldDescription>
	</field>
	<field name="nationality" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.nationality]]></fieldDescription>
	</field>
	<field name="nationalityComplet" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.nationalityComplet]]></fieldDescription>
	</field>
	<field name="applicantPhone" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.phone]]></fieldDescription>
	</field>
	<field name="applicantEmail" class="java.lang.String">
		<fieldDescription><![CDATA[applicant.email]]></fieldDescription>
	</field>
	<field name="typesReseau" class="java.lang.Object"/>
	<field name="services" class="java.lang.Object"/>
	<field name="sites" class="java.lang.Object"/>
	<field name="liaisons" class="java.lang.Object"/>
	<field name="signaturePresidence" class="java.lang.String"/>
	<variable name="fuseau" class="java.time.ZoneId" calculation="System">
		<initialValueExpression><![CDATA[java.time.ZoneId.of($P{FUSEAU_HORAIRE})]]></initialValueExpression>
	</variable>
	<variable name="numeroAutorisation" class="java.lang.String">
		<variableExpression><![CDATA[$F{referenceAttestation} == null ? "……………"
: $F{referenceAttestation}.matches("\\d+-\\d{2}-\\d{2}-\\d{4}")
  ? $F{referenceAttestation}.replaceAll("^(\\d+)-\\d{2}-\\d{2}-(\\d{4})$", "$1/AUT/RP/ARCEP/$2")
  : $F{referenceAttestation}]]></variableExpression>
	</variable>
	<variable name="titulaire" class="java.lang.String">
		<variableExpression><![CDATA[$F{company} != null && !$F{company}.trim().isEmpty() ? $F{company} : $F{clientName}]]></variableExpression>
	</variable>
	<variable name="typesLibelle" class="java.lang.String">
		<variableExpression><![CDATA[$F{typesReseau} == null ? ""
: java.util.stream.StreamSupport.stream(((com.fasterxml.jackson.databind.JsonNode) $F{typesReseau}).spliterator(), false)
    .map(n -> "AUTRE".equals(n.path("type").asText()) && n.hasNonNull("precisionAutre")
        ? n.path("precisionAutre").asText()
        : (String) $P{LIBELLES}.getOrDefault(n.path("type").asText(), n.path("type").asText()))
    .collect(java.util.stream.Collectors.joining(", "))]]></variableExpression>
	</variable>
	<variable name="nombreTypes" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{typesReseau} == null ? 0 : ((com.fasterxml.jackson.databind.JsonNode) $F{typesReseau}).size()]]></variableExpression>
	</variable>
	<variable name="servicesLibelle" class="java.lang.String">
		<variableExpression><![CDATA[$F{services} == null ? ""
: java.util.stream.StreamSupport.stream(((com.fasterxml.jackson.databind.JsonNode) $F{services}).spliterator(), false)
    .map(n -> $P{LIBELLES}.getOrDefault(n.path("type").asText(), n.path("type").asText())
        + (n.hasNonNull("portee") ? " " + $P{LIBELLES}.getOrDefault(n.path("portee").asText(), n.path("portee").asText()) : ""))
    .collect(java.util.stream.Collectors.joining(", "))]]></variableExpression>
	</variable>
	<variable name="nombreServices" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{services} == null ? 0 : ((com.fasterxml.jackson.databind.JsonNode) $F{services}).size()]]></variableExpression>
	</variable>
	<variable name="nombreSites" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{sites} == null ? 0 : ((com.fasterxml.jackson.databind.JsonNode) $F{sites}).size()]]></variableExpression>
	</variable>
	<variable name="nombreLiaisons" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{liaisons} == null ? 0 : ((com.fasterxml.jackson.databind.JsonNode) $F{liaisons}).size()]]></variableExpression>
	</variable>
	<variable name="sitesEnLettres" class="java.lang.String">
		<variableExpression><![CDATA[$V{nombreSites} <= 20
? new String[] {"aucun", "un", "deux", "trois", "quatre", "cinq", "six", "sept", "huit", "neuf", "dix",
    "onze", "douze", "treize", "quatorze", "quinze", "seize", "dix-sept", "dix-huit", "dix-neuf", "vingt"}[$V{nombreSites}]
  + " (" + String.format("%02d", $V{nombreSites}) + ")"
: String.valueOf($V{nombreSites})]]></variableExpression>
	</variable>
	<variable name="dateSignature" class="java.lang.String">
		<variableExpression><![CDATA[($P{DATE_SIGNATURE} != null ? $P{DATE_SIGNATURE}.toInstant() : java.time.Instant.now())
    .atZone($V{fuseau}).format(java.time.format.DateTimeFormatter.ofPattern("dd MMMM yyyy", java.util.Locale.FRENCH))]]></variableExpression>
	</variable>
