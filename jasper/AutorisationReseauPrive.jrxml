<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutorisationReseauPrive : autorisation d'établissement et d'exploitation d'un
  réseau privé (DRRRS, dossier DemandeReseau), avec son annexe « Condition
  d'exploitation ». JasperReports / Jaspersoft Studio 6.21.2.

  Modèle : l'acte signé « AUTORISATION N° 004/AUT/RP/ARCEP/2024 RELATIVE A
  L'ETABLISSEMENT ET A L'EXPLOITATION DE RESEAUX PRIVES » (Président du
  Conseil de Régulation) ; mêmes chapitres et articles, mêmes rubriques.

  Données : le JSON du dossier (DemandeReseauOutputDTO) avec l'attestation
  créée au passage « Pour Signature » dans attestations[0] (reference, id,
  classId, nomModele = natureReseau). Champ facultatif : signaturePresidence
  (image base64, comme la signature des attestations ASI / homologation).
  Le numéro « 0084-28-09-2026 » de la séquence kernel est imprimé au format
  officiel « 0084/AUT/RP/ARCEP/2026 » ; la référence brute reste en pied de
  signature pour la traçabilité.

  Images : « logo-arcep » et « filigrane-arcep » ont une image par défaut
  intégrée. Une ressource du même nom fournie par le kernel la remplace.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AutorisationReseauPrive" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24" isSummaryNewPage="true" isSummaryWithPageHeaderAndFooter="true" uuid="8504f866-a726-5a57-9d61-165effe434de">
	<property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9.5" forecolor="#000000"/>
	<style name="Article" style="Base" hTextAlign="Justified" markup="styled" fontSize="9.5">
