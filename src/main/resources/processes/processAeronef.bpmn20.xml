        <flowNodeRef>Task_validation_rapport</flowNodeRef>
        <flowNodeRef>Gw_frais</flowNodeRef>
        <flowNodeRef>Task_validation_ordre</flowNodeRef>
        <flowNodeRef>Gw_signataire</flowNodeRef>
        <flowNodeRef>Task_signature_chef</flowNodeRef>
        <flowNodeRef>End_aeronef</flowNodeRef>
      </lane>
      <lane id="lane_technique" name="Service Technique">
        <flowNodeRef>Task_etude</flowNodeRef>
        <flowNodeRef>Gw_retour_etude</flowNodeRef>
      </lane>
      <lane id="lane_comptabilite" name="Comptabilité">
        <flowNodeRef>Task_ordre_recette</flowNodeRef>
      </lane>
      <lane id="lane_commerce" name="Direction Commerce">
        <flowNodeRef>Task_signature_presidence</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_aeronef" name="Début" />
    <userTask id="Task_saisie" name="Saisie &#38; Étude Complétude Dossier" flowable:assignee="Réception" flowable:candidateGroups="Reception" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','En attente')}" event="start" />
        <flowable:executionListener expression="${createEvent._execute(execution,'DepotAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">WRITE</flowable:entry>
              <flowable:entry key="SectionStation">WRITE</flowable:entry>
              <flowable:entry key="SectionEquipements">WRITE</flowable:entry>
              <flowable:entry key="SectionAttachment">WRITE</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="Task_numerotation" name="Contrôle &#38; Numérotation du Dossier" flowable:assignee="Service Numérotation" flowable:candidateGroups="Numerotation" flowable:dueDate="P3D" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','En cours')}" event="start" />
        <flowable:executionListener expression="${createEvent._execute(execution,'NumeriserAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">WRITE</flowable:entry>
              <flowable:entry key="SectionStation">WRITE</flowable:entry>
              <flowable:entry key="SectionEquipements">WRITE</flowable:entry>
              <flowable:entry key="SectionAttachment">WRITE</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gw_retour_numerotation" />
    <userTask id="Task_orientation" name="Orientation du Dossier" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:dueDate="P2D" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'OrientationAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">READ</flowable:entry>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionEquipements">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gw_retour_orientation" />
    <userTask id="Task_etude" name="Étude Technique" flowable:assignee="Service Technique" flowable:candidateGroups="ServiceTechnique" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'EtudeTechniqueAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">WRITE</flowable:entry>
              <flowable:entry key="SectionStation">WRITE</flowable:entry>
              <flowable:entry key="SectionEquipements">WRITE</flowable:entry>
              <flowable:entry key="SectionAttachment">WRITE</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gw_retour_etude" />
    <userTask id="Task_validation_rapport" name="Validation Rapport Technique" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'ValidationRapportAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">READ</flowable:entry>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionEquipements">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gw_frais" name="Frais de dossier a percevoir ?" />
    <userTask id="Task_ordre_recette" name="Établir l&#39;Ordre de Recette" flowable:assignee="Service Comptabilité" flowable:candidateGroups="Comptabilite" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'OrdreRecetteNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
