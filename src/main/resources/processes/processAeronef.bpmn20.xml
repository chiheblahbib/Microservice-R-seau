          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre le dossier a la suite du circuit" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${data.statutDossier== 'soumis'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_sys_sans_frais" name="sys_sans_ordre_recette" sourceRef="Gw_frais" targetRef="Gw_signataire">
      <conditionExpression xsi:type="tFormalExpression">${data.statutDossier!= 'soumis'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ordre_validation" name="Pour Validation" sourceRef="Task_ordre_recette" targetRef="Task_validation_ordre">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre l'ordre de recette à validation" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_vers_gw_type" sourceRef="Task_validation_ordre" targetRef="Gw_signataire" />
    <sequenceFlow id="Flow_sys_presidence" name="Pour Signature" sourceRef="Gw_signataire" targetRef="Task_signature_presidence">
      <extensionElements>
