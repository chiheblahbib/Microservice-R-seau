        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${data.typeDossier== 'COMMERCE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_sys_chef" name="sys_signature_chef" sourceRef="Gw_signataire" targetRef="Task_signature_chef">
