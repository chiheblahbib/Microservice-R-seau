          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="Task_validation_ordre" name="Validation Ordre de Recette" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'ValidationOrdreRecetteNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">READ</flowable:entry>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionEquipements">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
<exclusiveGateway id="Gw_signataire" name="Quel signataire ?">
      <extensionElements>
        <!--
          DELIVRANCE DU TITRE.

          Pose sur la passerelle et non sur un flux : les deux branches menent a
          une signature, et l'autorisation doit exister AVANT d'etre signee. Un
          ecouteur par branche aurait duplique l'expression pour le meme effet.

          La garde protege des retours en arriere : ce point est re-traversable
          par la boucle « Retourner », et AttestationService n'est pas idempotent
          ~~ sans elle, chaque aller-retour delivrerait un titre de plus.

          `data.attestations` vient de DemandeAeronefOutputDTO, que le moteur
          reserialise a chaque transition : au second passage, la liste n'est
          plus vide et rien n'est recree.
        -->
        <flowable:executionListener expression="${empty data.attestations ? attestationService.createAttestationForAutorisation(data) : execution.setVariable('isCreatedAtt', true)}" event="start" />
      </extensionElements>
    </exclusiveGateway>
    <userTask id="Task_signature_presidence" name="Signature du Pr&#233;sident du Conseil de R&#233;gulation" flowable:assignee="Direction Commerce" flowable:candidateGroups="DirectionCommerce" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'SignaturePresidenceAeronefNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">READ</flowable:entry>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionEquipements">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="Task_signature_chef" name="Signature du Dossier" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'SignatureDossierNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionOperateur">READ</flowable:entry>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionEquipements">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <endEvent id="End_aeronef" name="Clôturé">
      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','Clôturé')}" event="start" />
      </extensionElements>
    </endEvent>
    <sequenceFlow id="Flow_debut" sourceRef="Start_aeronef" targetRef="Task_saisie" />
    <sequenceFlow id="Flow_soumettre" name="Soumettre" sourceRef="Task_saisie" targetRef="Task_numerotation">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre le dossier au service numérotation" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_vers_gw_num" sourceRef="Task_numerotation" targetRef="Gw_retour_numerotation" />
    <sequenceFlow id="Flow_accepter" name="Accepter" sourceRef="Gw_retour_numerotation" targetRef="Task_orientation">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Accepter et orienter le dossier" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_accepter'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_num_retour" name="Retourner" sourceRef="Gw_retour_numerotation" targetRef="Task_saisie">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-red-600 hover:bg-red-700 text-white" />
          <flowable:property name="icon" value="undo" />
          <flowable:property name="decisionMessageConfirmation" value="Retourner le dossier à la réception" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_num_retour'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_vers_gw_orientation" sourceRef="Task_orientation" targetRef="Gw_retour_orientation" />
    <sequenceFlow id="Flow_pour_etude" name="Pour Étude" sourceRef="Gw_retour_orientation" targetRef="Task_etude">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Transmettre au service technique" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_pour_etude'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_orientation_verif" name="Pour Vérification" sourceRef="Gw_retour_orientation" targetRef="Task_numerotation">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-red-600 hover:bg-red-700 text-white" />
          <flowable:property name="icon" value="undo" />
          <flowable:property name="decisionMessageConfirmation" value="Renvoyer au service numérotation" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_orientation_verif'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_vers_gw_etude" sourceRef="Task_etude" targetRef="Gw_retour_etude" />
    <sequenceFlow id="Flow_pour_validation" name="Pour Validation" sourceRef="Gw_retour_etude" targetRef="Task_validation_rapport">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre le rapport technique à validation" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_pour_validation'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_etude_retour" name="Retourner" sourceRef="Gw_retour_etude" targetRef="Task_orientation">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-red-600 hover:bg-red-700 text-white" />
          <flowable:property name="icon" value="undo" />
          <flowable:property name="decisionMessageConfirmation" value="Retourner au chef de centre" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_etude_retour'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_vers_gw_statut" sourceRef="Task_validation_rapport" targetRef="Gw_frais" />
    <sequenceFlow id="Flow_sys_avec_frais" name="Soumettre" sourceRef="Gw_frais" targetRef="Task_ordre_recette">
      <extensionElements>
