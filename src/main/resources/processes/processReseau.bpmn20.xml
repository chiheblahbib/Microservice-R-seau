    <!-- DELIVRANCE DU TITRE au passage de « Pour Signature » (v22 de l'admin kernel, qui a
         retire la tache « Automatique » et la passerelle « Quel signataire ? ») : l'autorisation
         doit exister AVANT d'etre signee. La garde protege des retours en arriere :
         AttestationService n'est pas idempotent, et `data.attestations`
         (DemandeReseauOutputDTO, reserialise a chaque transition) n'est plus vide au second
         passage. -->
    <sequenceFlow id="Flow_ordre_valider" name="Pour Signature" sourceRef="Gw_retour_ordre" targetRef="Task_signature_presidence">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Valider l'ordre de recette et transmettre a la signature" />
        </flowable:properties>
        <flowable:executionListener expression="${empty data.attestations ? attestationService.createAttestationForAutorisation(data) : execution.setVariable('isCreatedAtt', true)}" event="take" />
