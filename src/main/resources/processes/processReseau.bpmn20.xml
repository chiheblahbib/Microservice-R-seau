    <!-- RAPPORT TECHNIQUE, comme la decharge : l'evenement kernel RapportTechniqueReseau (classe
         DemandeReseau) produit le PDF avec le modele du meme nom et le range dans jrxml-events.
         `data` porte la conclusion saisie par le technicien et son nom (agentDecision). -->
    <sequenceFlow id="Flow_pour_validation" name="Pour Validation" sourceRef="Gw_retour_etude" targetRef="Task_validation_rapport">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre le rapport technique à validation" />
        </flowable:properties>
        <flowable:executionListener expression="${data.setState('En cours')}" event="take" />
        <flowable:executionListener expression="${createEvent._execute(execution,'RapportTechniqueReseau')}" event="take" />
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == 'Flow_pour_validation'}</conditionExpression>
