<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================================
  processStation ~ le circuit du TITRE
  ============================================================================================
  A DEPLOYER EN XML DIRECT (voir l'en-tete de processImplantation).

  CE QUE CE CIRCUIT EST, ET CE QU'IL N'EST PLUS
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Il ne refait plus l'instruction du dossier. Il rejouait la completude, la
  numerotation et l'orientation que le circuit parent venait de faire, avec les
  memes personnes et sur le meme objet : quatre etapes pour rien. Elles sont
  retirees. Ce qui reste est ce qui se repete : PREPARER, VISER, SIGNER, REMETTRE.

  UN SEUL CHEMIN, POUR LE PREMIER TITRE COMME POUR LES SUIVANTS
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  C'est la propriete qui rend ce circuit simple : delivrer un titre pour la premiere
  fois et le reemettre sont le meme travail. Aucune passerelle de nature, aucune
  colonne d'episode, aucun chemin a sauter. Une instance = un titre.

  DEUX FACONS DE L'OUVRIR, LA MEME SUITE
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  1. le circuit parent, a sa signature ~ ${stationService.ouvrirTitre(data.id)}
  2. un renouvellement ou un controle annuel, declenche a la main sur la station
  Le parent ne s'ouvre pas une seconde fois : c'est tout l'interet de la separation.
  Un renouvellement ne renumerote rien, ne facture rien, ne redemande aucune
  signature commerciale.

  L'AUTORISATION EST CREEE ICI, ET SEULEMENT ICI
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  La garde porte sur isCreatedAtt, variable D'INSTANCE : la boucle "Pour
  Verification" reste protegee (meme instance), et un titre suivant repart d'une
  variable vide, donc se cree bien. Elle testait `empty data.attestations`, ce qui
  interdisait toute reemission.

  CE QUE CE FICHIER EXIGE, ET QUI N'EXISTE PAS ENCORE
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  1. AttestationService.createAttestationForStation(StationOutputDTO)
     La methode appelee jusqu'ici prend un DemandeReseauOutputDTO et pose
     setDemandeReseau : elle ne peut pas poser station_id. Aucune ligne du code ne
     cree aujourd'hui l'attestation d'une station.
  2. StationService.ouvrirTitre(Long demandeImplantationId)
     Remplace initFromDemande. Refuse d'ouvrir si un titre est deja en cours sur la
     station, accepte sinon ~ c'est ce qui autorise le deuxieme titre et interdit le
     doublon. La meme methode sert au parent et au renouvellement.
  ============================================================================================
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://flowable.org/test">
  <collaboration id="Collaboration_processStation">
    <participant id="pool_processStation" name="Titre d&#39;implantation d&#39;une station" processRef="processStation" />
  </collaboration>
  <process id="processStation" name="Titre d&#39;implantation d&#39;une station" isExecutable="true">
    <laneSet id="laneSet_processStation">
      <lane id="lane_technique" name="Service Technique">
        <flowNodeRef>Start_station</flowNodeRef>
        <flowNodeRef>Task_s_etude</flowNodeRef>
      </lane>
      <lane id="lane_chefcentre" name="Chef Centre">
        <flowNodeRef>Task_s_visa</flowNodeRef>
        <flowNodeRef>Gw_s_visa</flowNodeRef>
        <flowNodeRef>Task_s_informer</flowNodeRef>
      </lane>
      <lane id="lane_presidence" name="Présidence de l&#39;Autorité">
        <flowNodeRef>Task_s_signature</flowNodeRef>
      </lane>
      <lane id="lane_numerotation" name="Réception &#38; Numérotation">
        <flowNodeRef>Task_s_decharge</flowNodeRef>
        <flowNodeRef>End_station</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_station" name="Début" />
<userTask id="Task_s_etude" name="Étude Technique" flowable:assignee="Service Technique" flowable:candidateGroups="ServiceTechnique" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','En cours')}" event="start" />
        <flowable:executionListener expression="${createEvent._execute(execution,'EtudeTechniqueStationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">WRITE</flowable:entry>
              <flowable:entry key="SectionSite">WRITE</flowable:entry>
              <flowable:entry key="SectionFrequence">WRITE</flowable:entry>
              <flowable:entry key="SectionAttachment">WRITE</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
<userTask id="Task_s_visa" name="Viser les Certificats" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'VisaCertificatStationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionSite">READ</flowable:entry>
              <flowable:entry key="SectionFrequence">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gw_s_visa" />
<userTask id="Task_s_signature" name="Signer l&#39;Autorisation" flowable:assignee="${data.signataire}" flowable:candidateGroups="${data.signataire}" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'SignatureAutorisationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionSite">READ</flowable:entry>
              <flowable:entry key="SectionFrequence">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
<userTask id="Task_s_informer" name="Informer l&#39;opérateur" flowable:assignee="Chef Centre" flowable:candidateGroups="ChefCentre" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'InformerOperateurStationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionSite">READ</flowable:entry>
              <flowable:entry key="SectionFrequence">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
<userTask id="Task_s_decharge" name="Décharger la livraison" flowable:assignee="Reception &amp; Numerotation" flowable:candidateGroups="Numerotation,Reception" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:executionListener expression="${createEvent._execute(execution,'DechargeStationNotif')}" event="start" />
        <flowable:inputOutput>
          <flowable:inputParameter name="components">
            <flowable:map>
              <flowable:entry key="SectionStation">READ</flowable:entry>
              <flowable:entry key="SectionSite">READ</flowable:entry>
              <flowable:entry key="SectionFrequence">READ</flowable:entry>
              <flowable:entry key="SectionAttachment">READ</flowable:entry>
            </flowable:map>
          </flowable:inputParameter>
        </flowable:inputOutput>
      </extensionElements>
    </userTask>
<endEvent id="End_station" name="Confirmé &#38; Clôturé">
      <extensionElements>
        <flowable:executionListener expression="${execution.setVariable('${data.state}','Confirmé &amp; Clôturé')}" event="start" />
      </extensionElements>
    </endEvent>
    <sequenceFlow id="Flow_s_debut" sourceRef="Start_station" targetRef="Task_s_etude" />
    <sequenceFlow id="Flow_s_visa" name="Visa des Certificats" sourceRef="Task_s_etude" targetRef="Task_s_visa">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Soumettre les certificats au visa" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_vers_gw_visa" sourceRef="Task_s_visa" targetRef="Gw_s_visa" />
    <sequenceFlow id="Flow_s_pour_signature" name="Envoyer pour Signature" sourceRef="Gw_s_visa" targetRef="Task_s_signature">
      <extensionElements>
        <flowable:executionListener expression="${empty isCreatedAtt ? attestationService.createAttestationForStation(data) : &apos;&apos;}" event="take" />
        <flowable:executionListener expression="${execution.setVariable(&apos;isCreatedAtt&apos;, true)}" event="take" />
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Envoyer l&apos;autorisation à la signature" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == &apos;Flow_s_pour_signature&apos;}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_visa_verif" name="Pour Vérification" sourceRef="Gw_s_visa" targetRef="Task_s_etude">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="1" />
          <flowable:property name="color" value="bg-red-600 hover:bg-red-700 text-white" />
          <flowable:property name="icon" value="undo" />
          <flowable:property name="decisionMessageConfirmation" value="Renvoyer au service technique" />
        </flowable:properties>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${Decision == &apos;Flow_s_visa_verif&apos;}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_informer" name="Soumettre" sourceRef="Task_s_signature" targetRef="Task_s_informer">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Informer l&apos;opérateur" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_decharge" name="Soumettre" sourceRef="Task_s_informer" targetRef="Task_s_decharge">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="submit" />
          <flowable:property name="decisionMessageConfirmation" value="Transmettre pour décharge" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_s_confirmer" name="Confirmer" sourceRef="Task_s_decharge" targetRef="End_station">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="ordre" value="0" />
          <flowable:property name="color" value="bg-green-600 hover:bg-green-700 text-white" />
          <flowable:property name="icon" value="check" />
          <flowable:property name="decisionMessageConfirmation" value="Confirmer et clôturer" />
        </flowable:properties>
      </extensionElements>
    </sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_processStation">
    <bpmndi:BPMNPlane id="BPMNPlane_processStation" bpmnElement="Collaboration_processStation">
      <bpmndi:BPMNShape id="BPMNShape_pool_processStation" bpmnElement="pool_processStation" isHorizontal="true">
        <omgdc:Bounds x="40" y="20" width="1300" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_technique" bpmnElement="lane_technique" isHorizontal="true">
        <omgdc:Bounds x="70" y="20" width="1270" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_chefcentre" bpmnElement="lane_chefcentre" isHorizontal="true">
        <omgdc:Bounds x="70" y="170" width="1270" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_presidence" bpmnElement="lane_presidence" isHorizontal="true">
        <omgdc:Bounds x="70" y="320" width="1270" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_numerotation" bpmnElement="lane_numerotation" isHorizontal="true">
        <omgdc:Bounds x="70" y="470" width="1270" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Start_station" bpmnElement="Start_station">
        <omgdc:Bounds x="130" y="80" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_s_etude" bpmnElement="Task_s_etude">
        <omgdc:Bounds x="210" y="60" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_s_visa" bpmnElement="Task_s_visa">
        <omgdc:Bounds x="400" y="210" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gw_s_visa" bpmnElement="Gw_s_visa">
        <omgdc:Bounds x="590" y="225" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_s_signature" bpmnElement="Task_s_signature">
        <omgdc:Bounds x="680" y="360" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_s_informer" bpmnElement="Task_s_informer">
        <omgdc:Bounds x="870" y="210" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_s_decharge" bpmnElement="Task_s_decharge">
        <omgdc:Bounds x="1060" y="510" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End_station" bpmnElement="End_station">
        <omgdc:Bounds x="1240" y="530" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_debut" bpmnElement="Flow_s_debut">
        <omgdi:waypoint x="145" y="95" />
        <omgdi:waypoint x="210" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_visa" bpmnElement="Flow_s_visa">
        <omgdi:waypoint x="300" y="130" />
        <omgdi:waypoint x="300" y="245" />
        <omgdi:waypoint x="400" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_vers_gw_visa" bpmnElement="Flow_s_vers_gw_visa">
        <omgdi:waypoint x="530" y="245" />
        <omgdi:waypoint x="590" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_pour_signature" bpmnElement="Flow_s_pour_signature">
        <omgdi:waypoint x="610" y="265" />
        <omgdi:waypoint x="610" y="395" />
        <omgdi:waypoint x="680" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_visa_verif" bpmnElement="Flow_s_visa_verif">
        <omgdi:waypoint x="610" y="225" />
        <omgdi:waypoint x="610" y="180" />
        <omgdi:waypoint x="250" y="180" />
        <omgdi:waypoint x="250" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_informer" bpmnElement="Flow_s_informer">
        <omgdi:waypoint x="810" y="395" />
        <omgdi:waypoint x="935" y="395" />
        <omgdi:waypoint x="935" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_decharge" bpmnElement="Flow_s_decharge">
        <omgdi:waypoint x="1000" y="245" />
        <omgdi:waypoint x="1125" y="245" />
        <omgdi:waypoint x="1125" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_s_confirmer" bpmnElement="Flow_s_confirmer">
        <omgdi:waypoint x="1190" y="545" />
        <omgdi:waypoint x="1240" y="545" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
